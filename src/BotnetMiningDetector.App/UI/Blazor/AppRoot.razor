    private RenderFragment Export() => @<article class="card">
        <h2>Exportación CSV</h2>
        <p>Exporta métricas del sistema, procesos, alertas, escenarios y resumen de evaluación.</p>
        <p><strong>Ruta:</strong> Carpeta Descargas del usuario</p>
        <p>@Vm.ExportStatus</p>
        <div class="button-row">
            <button type="button" data-agent-action="export" @onclick="Vm.ExportAsync">Exportar resultados</button>
            <button type="button" class="secondary" data-agent-action="clear" @onclick="Vm.ClearExperimentDataAsync">Limpiar resultados</button>
        </div>
    </article>;

    private IEnumerable<ProcessMetric> FilteredProcesses => SortProcesses(Vm.CurrentProcesses.Where(MatchesProcess));
    private IEnumerable<Alert> FilteredAlerts => SortAlerts(Vm.Alerts.Where(MatchesAlert));
    private IEnumerable<ProcessBaseline> FilteredBaselines => SortBaselines(Vm.ProcessBaselines.Where(MatchesBaseline));
    private IEnumerable<ValidationScenario> FilteredScenarios => SortScenarios(Vm.ValidationScenarios.Where(MatchesScenario));
    private double GlobalCpuThreshold => Vm.ActiveBaseline is null
        ? 0
        : Math.Max(Vm.Settings.MinCpuThreshold, Vm.ActiveBaseline.CpuAverage + Vm.Settings.StandardDeviationMultiplier * Math.Max(1, Vm.ActiveBaseline.CpuStdDev));
    private double GlobalMemoryThreshold => Vm.ActiveBaseline is null
        ? 0
        : Vm.ActiveBaseline.MemoryAverage + Vm.Settings.StandardDeviationMultiplier * Math.Max(1, Vm.ActiveBaseline.MemoryStdDev);

    private RenderFragment FilterInput(string key, string placeholder) => @<label class="field table-filter">
        <span>Filtro</span>
        <input type="search" value="@Interaction.GetFilter(key)" placeholder="@placeholder" data-agent-filter="@key" @oninput="eventArgs => SetFilter(key, eventArgs)" />
    </label>;

    private RenderFragment SelectFilter(string key, string label, IEnumerable<(string Value, string Text)> options) => @<label class="field table-filter compact-field">
        <span>@label</span>
        <select value="@Interaction.GetFilter(key)" data-agent-filter="@key" @onchange="eventArgs => SetFilter(key, eventArgs)">
            @foreach (var option in options)
            {
                <option value="@option.Value">@option.Text</option>
            }
        </select>
    </label>;

    private RenderFragment ColumnToggle(string key, string label) => @<label class="column-toggle">
        <input type="checkbox" checked="@Column(key)" data-agent-column="@key" @onchange="eventArgs => SetColumn(key, eventArgs)" />
        <span>@label</span>
    </label>;

    private RenderFragment SortHeader(string table, string column, string label) => @<th>
        <button type="button" class="sort-header" @onclick="() => Interaction.ToggleSort(table, column)">
            <span>@label</span>
            <span class="sort-indicator">@SortIndicator(table, column)</span>
        </button>
    </th>;

    private RenderFragment ReadOnlyMetric(string label, string value) => @<div class="readonly-metric">
        <span>@label</span>
        <strong>@value</strong>
    </div>;

    private RenderFragment RuleBadge(string label, bool isEnabled) => @<div class="rule-line">
        <span>@label</span>
        <span class="badge @(isEnabled ? "ok" : "danger")">@(isEnabled ? "Activa" : "Inactiva")</span>
    </div>;

    private RenderFragment NumberInput(string key, string label, double value, Action<double> setValue) => @<label class="field">
        <span>@label</span>
        <input type="number" step="0.1" value="@value" data-agent-setting="@key" @onchange="eventArgs => SetNumber(eventArgs, setValue)" />
    </label>;

    private RenderFragment Toggle(string key, string label, bool value, Action<bool> setValue) => @<label class="toggle">
        <input type="checkbox" checked="@value" data-agent-setting="@key" @onchange="eventArgs => SetBool(eventArgs, setValue)" />
        <span>@label</span>
    </label>;

    private bool Column(string key) => Interaction.IsColumnVisible(key);

    private string SortIndicator(string table, string column)
    {
        var state = Interaction.GetSortState(table);
        if (!state.Column.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            return string.Empty;
        }

        return state.Ascending ? "↑" : "↓";
    }

    private IEnumerable<ProcessMetric> SortProcesses(IEnumerable<ProcessMetric> processes)
    {
        var sort = Interaction.GetSortState("processes");
        return sort.Column switch
        {
            "pid" => SortBy(processes, process => process.ProcessId, sort.Ascending),
            "name" => SortBy(processes, process => process.ProcessName, sort.Ascending),
            "cpu" => SortBy(processes, process => process.CpuPercent, sort.Ascending),
            "memory" => SortBy(processes, process => process.MemoryMb, sort.Ascending),
            "life" => SortBy(processes, process => process.LifetimeSeconds ?? -1, sort.Ascending),
            "network" => SortBy(processes, process => process.NetworkConnectionCount, sort.Ascending),
            "known" => SortBy(processes, process => process.IsKnownProcess ? 1 : 0, sort.Ascending),
            "time" => SortBy(processes, process => process.Timestamp, sort.Ascending),
            "path" => SortBy(processes, process => process.ExecutablePath, sort.Ascending),
            _ => processes
        };
    }

    private IEnumerable<Alert> SortAlerts(IEnumerable<Alert> alerts)
    {
        var sort = Interaction.GetSortState("alerts");
        return sort.Column switch
        {
            "date" => SortBy(alerts, alert => alert.Timestamp, sort.Ascending),
            "severity" => SortBy(alerts, alert => SeverityRank(alert.Severity), sort.Ascending),
            "type" => SortBy(alerts, alert => alert.AlertType, sort.Ascending),
            "rule" => SortBy(alerts, alert => alert.RuleName, sort.Ascending),
            "category" => SortBy(alerts, alert => RuleCategoryLabel(alert.RuleCategory), sort.Ascending),
            "process" => SortBy(alerts, alert => alert.ProcessName, sort.Ascending),
            "status" => SortBy(alerts, alert => alert.WasAcknowledged ? 1 : 0, sort.Ascending),
            _ => alerts
        };
    }

    private IEnumerable<ProcessBaseline> SortBaselines(IEnumerable<ProcessBaseline> baselines)
    {
        var sort = Interaction.GetSortState("baseline");
        return sort.Column switch
        {
            "process" => SortBy(baselines, baseline => baseline.ProcessName, sort.Ascending),
            "cpuAvg" => SortBy(baselines, baseline => baseline.AverageCpu, sort.Ascending),
            "cpuDev" => SortBy(baselines, baseline => baseline.StdDevCpu, sort.Ascending),
            "memoryAvg" => SortBy(baselines, baseline => baseline.AverageMemory, sort.Ascending),
            "memoryDev" => SortBy(baselines, baseline => baseline.StdDevMemory, sort.Ascending),
            "tcpAvg" => SortBy(baselines, baseline => baseline.AverageNetworkConnections, sort.Ascending),
            "tcpDev" => SortBy(baselines, baseline => baseline.StdDevNetworkConnections, sort.Ascending),
            "life" => SortBy(baselines, baseline => baseline.TypicalLifetimeSeconds, sort.Ascending),
            "count" => SortBy(baselines, baseline => baseline.OccurrenceCount, sort.Ascending),
            _ => baselines
        };
    }

    private IEnumerable<ValidationScenario> SortScenarios(IEnumerable<ValidationScenario> scenarios)
    {
        var sort = Interaction.GetSortState("scenarios");
        return sort.Column switch
        {
            "start" => SortBy(scenarios, scenario => scenario.StartedAt, sort.Ascending),
            "end" => SortBy(scenarios, scenario => scenario.FinishedAt ?? DateTime.MinValue, sort.Ascending),
            "name" => SortBy(scenarios, scenario => scenario.Name, sort.Ascending),
            "category" => SortBy(scenarios, scenario => scenario.ScenarioCategory, sort.Ascending),
            "description" => SortBy(scenarios, scenario => scenario.Description, sort.Ascending),
            "process" => SortBy(scenarios, scenario => scenario.ProcessName, sort.Ascending),
            "duration" => SortBy(scenarios, scenario => scenario.DurationSeconds ?? -1, sort.Ascending),
            "expected" => SortBy(scenarios, scenario => scenario.ExpectedResult, sort.Ascending),
            "actual" => SortBy(scenarios, scenario => scenario.ActualResult, sort.Ascending),
            "classification" => SortBy(scenarios, scenario => scenario.ActualClassification, sort.Ascending),
            "confusion" => SortBy(scenarios, scenario => scenario.ConfusionResult, sort.Ascending),
            "alert" => SortBy(scenarios, scenario => scenario.AlertGenerated ? 1 : 0, sort.Ascending),
            "time" => SortBy(scenarios, scenario => scenario.DetectionTimeSeconds ?? -1, sort.Ascending),
            "notes" => SortBy(scenarios, scenario => scenario.Notes, sort.Ascending),
            _ => scenarios
        };
    }

    private static IEnumerable<T> SortBy<T, TKey>(IEnumerable<T> values, Func<T, TKey> keySelector, bool ascending)
    {
        return ascending ? values.OrderBy(keySelector) : values.OrderByDescending(keySelector);
    }

    private void SetFilter(string key, ChangeEventArgs eventArgs)
    {
        Interaction.SetFilter(key, Convert.ToString(eventArgs.Value) ?? string.Empty);
    }

    private void SetColumn(string key, ChangeEventArgs eventArgs)
    {
        if (eventArgs.Value is bool value)
        {
            Interaction.SetColumnVisible(key, value);
        }
    }

    private bool MatchesProcess(ProcessMetric process)
    {
        var search = Interaction.GetFilter("process-search");
        var known = Interaction.GetFilter("process-known");
        var matchesKnown = known switch
        {
            "known" => process.IsKnownProcess,
            "unknown" => !process.IsKnownProcess,
            _ => true
        };

        return matchesKnown && MatchesSearch(search, process.ProcessId.ToString(), process.ProcessName, process.ExecutablePath);
    }

    private bool MatchesAlert(Alert alert)
    {
        var severity = Interaction.GetFilter("alert-severity");
        var status = Interaction.GetFilter("alert-status");
        var matchesSeverity = string.IsNullOrWhiteSpace(severity) || alert.Severity.Equals(severity, StringComparison.OrdinalIgnoreCase);
        var matchesStatus = status switch
        {
            "pending" => !alert.WasAcknowledged,
            "ack" => alert.WasAcknowledged,
            _ => true
        };

        return matchesSeverity &&
               matchesStatus &&
               MatchesSearch(Interaction.GetFilter("alert-search"), alert.ProcessName, alert.AlertType, alert.RuleName, alert.RuleCategory, alert.Description);
    }

    private bool MatchesBaseline(ProcessBaseline baseline)
    {
        return MatchesSearch(Interaction.GetFilter("baseline-search"), baseline.ProcessName);
    }

    private bool MatchesScenario(ValidationScenario scenario)
    {
        return MatchesSearch(
            Interaction.GetFilter("scenario-search"),
            scenario.Name,
            scenario.ScenarioType,
            scenario.ScenarioCategory,
            scenario.Description,
            scenario.ProcessName,
            scenario.ExpectedResult,
            scenario.ActualResult,
            scenario.ActualClassification,
            scenario.ConfusionResult,
            scenario.Notes);
    }

    private static bool MatchesSearch(string search, params string?[] values)
    {
        if (string.IsNullOrWhiteSpace(search))
        {
            return true;
        }

        return values.Any(value => !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase));
    }

    private static string AlertNumber(Alert alert, double? value)
    {
        if (value is not null)
        {
            return $"{value.Value:N2}";
        }

        return alert.ThresholdType switch
        {
            "Statistical" => "No disponible en la alerta registrada",
            "Absolute" => "No aplica para una regla absoluta de laboratorio",
            "Heuristic" => "No aplica: esta regla es heurística y no usa media/desviación",
            "Correlation" => "No aplica: esta regla combina señales ya evaluadas",
            _ => "No aplica"
        };
    }

    private static string AlertEvidence(Alert alert)
    {
        if (!string.IsNullOrWhiteSpace(alert.EvidenceDetails))
        {
            return alert.EvidenceDetails;
        }

        return alert.ThresholdType switch
        {
            "Heuristic" => "La alerta fue registrada por una regla heurística. Revise métrica observada y referencia usada; las alertas antiguas pueden no tener evidencia técnica extendida.",
            "Correlation" => "La alerta fue registrada por correlación de señales. Revise la referencia usada para ver qué señales coincidieron.",
            _ => "La alerta no contiene evidencia técnica extendida. Genere una nueva prueba después de esta actualización para registrar el detalle completo."
        };
    }

    private static string AlertMethodologyExplanation(Alert alert)
    {
        return alert.ThresholdType switch
        {
            "Statistical" => "Regla estadística: compara la medición actual contra la media y desviación estándar aprendidas en la línea base.",
            "Absolute" => "Regla absoluta de laboratorio: usa un límite fijo para validar el prototipo en pruebas controladas.",
            "Heuristic" => "Regla heurística: evalúa una señal observable que puede apoyarse en la línea base o en criterios de laboratorio, como periodicidad o ruta sospechosa.",
            "Correlation" => "Regla de correlación: aumenta severidad cuando coinciden varias señales en el mismo proceso.",
            _ => "Regla de detección local."
        };
    }

    private static string ThresholdTypeLabel(string thresholdType)
    {
        return thresholdType switch
        {
            "Statistical" => "Estadística",
            "Absolute" => "Absoluta de laboratorio",
            "Heuristic" => "Heurística",
            "Correlation" => "Correlación",
            _ => "No disponible"
        };
    }

    private static string RuleCategoryLabel(string category)
    {
        return category switch
        {
            "Cpu" => "CPU",
            "Memory" => "Memoria",
            "Network" => "Red",
            "Persistence" => "Persistencia",
            "SuspiciousPath" => "Ruta sospechosa",
            "Correlation" => "Correlación",
            _ => string.IsNullOrWhiteSpace(category) ? "No disponible" : category
        };
    }

    private static void SetNumber(ChangeEventArgs eventArgs, Action<double> setValue)
    {
        if (double.TryParse(Convert.ToString(eventArgs.Value), out var value))
        {
            setValue(value);
        }
    }

    private static void SetBool(ChangeEventArgs eventArgs, Action<bool> setValue)
    {
        if (eventArgs.Value is bool value)
        {
            setValue(value);
        }
    }

    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        if (_timer is null)
        {
            return;
        }

        try
        {
            while (await _timer.WaitForNextTickAsync(cancellationToken))
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void OnViewModelChanged(object? sender, PropertyChangedEventArgs e)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnInteractionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private static string FormatPercent(double value) => $"{value:N2}%";
    private static string ScenarioTelemetrySummary(ValidationScenario scenario)
    {
        return $"{scenario.TelemetrySampleCount} muestras | " +
            $"CPU media/máx.: {scenario.AverageCpuPercent:N2}%/{scenario.MaximumCpuPercent:N2}% | " +
            $"RAM media/máx.: {scenario.AverageMemoryMb:N1}/{scenario.MaximumMemoryMb:N1} MB | " +
            $"TCP medio/máx.: {scenario.AverageNetworkConnections:N2}/{scenario.MaximumNetworkConnections:N0}" +
            (string.IsNullOrWhiteSpace(scenario.TriggeredRuleName) ? string.Empty : $" | Regla: {scenario.TriggeredRuleName}");
    }

    private static string BaselineCoverageText(BaselineProfile baseline) =>
        baseline.ExpectedSampleCount == 0 ? "No disponible" : $"{baseline.SampleCoveragePercent:N1}%";

    private static string BaselineSampleCountText(BaselineProfile baseline) =>
        baseline.ExpectedSampleCount == 0 ? "Línea base anterior a esta medición" : $"{baseline.SampleCount} de {baseline.ExpectedSampleCount} muestras";

    private static string BaselineGapText(BaselineProfile baseline) =>
        baseline.ExpectedSampleCount == 0 ? "No disponible" : $"{baseline.MaximumSampleGapSeconds:N1}s";

    private static string FormatMb(double value) => $"{value:N1} MB";
    private static string FormatSeconds(double? value) => value is null ? "N/D" : $"{value.Value:N0}s";
    private static string FormatNullable(double? value) => value is null ? "N/D" : $"{value.Value:N2}";
    private static string SeverityClass(string severity) => severity switch
    {
        var value when value.Equals("Alta", StringComparison.OrdinalIgnoreCase) => "danger",
        var value when value.Equals("Media", StringComparison.OrdinalIgnoreCase) => "warn",
        var value when value.Equals("Baja", StringComparison.OrdinalIgnoreCase) => "ok",
        _ => "neutral"
    };

    private static string StatusClass(string status) => status switch
    {
        var value when value.Equals("Activo", StringComparison.OrdinalIgnoreCase) => "active",
        var value when value.Equals("Aprendizaje", StringComparison.OrdinalIgnoreCase) => "learning",
        _ => "inactive"
    };

    private static int SeverityRank(string severity) => severity switch
    {
        var value when value.Equals("Alta", StringComparison.OrdinalIgnoreCase) => 3,
        var value when value.Equals("Media", StringComparison.OrdinalIgnoreCase) => 2,
        var value when value.Equals("Baja", StringComparison.OrdinalIgnoreCase) => 1,
        _ => 0
    };

    public void Dispose()
    {
        Vm.PropertyChanged -= OnViewModelChanged;
        Interaction.Changed -= OnInteractionChanged;
        _timerCancellation?.Cancel();
        _timer?.Dispose();
        _timerCancellation?.Dispose();
    }
}
