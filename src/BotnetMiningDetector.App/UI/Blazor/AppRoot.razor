@implements IDisposable
@inject MainViewModel Vm
@inject UiInteractionState Interaction

<div class="shell @(_isSidebarCollapsed ? "sidebar-collapsed" : string.Empty)">
    @if (_isSidebarCollapsed)
    {
        <button type="button"
                class="sidebar-restore"
                aria-label="Mostrar menú"
                aria-expanded="false"
                title="Mostrar menú"
                @onclick="ToggleSidebar">
            <span class="sidebar-toggle-icon" aria-hidden="true"></span>
        </button>
    }
    <aside class="sidebar">
        <button type="button"
                class="sidebar-toggle"
                aria-label="Ocultar menú"
                aria-expanded="true"
                title="Ocultar menú"
                @onclick="ToggleSidebar">
            <span class="sidebar-toggle-icon" aria-hidden="true"></span>
        </button>
        <div class="brand">
            <div class="brand-mark">BYC</div>
            <div>
                <strong>Agente local BYC</strong>
                <span>Interfaz local</span>
            </div>
        </div>
        <nav>
            <button type="button" class="@NavClass("dashboard")" data-agent-nav="dashboard" @onclick='() => SelectTab("dashboard")'>Panel</button>
            <button type="button" class="@NavClass("processes")" data-agent-nav="processes" @onclick='() => SelectTab("processes")'>Procesos</button>
            <button type="button" class="@NavClass("alerts")" data-agent-nav="alerts" @onclick='() => SelectTab("alerts")'>Alertas</button>
            <button type="button" class="@NavClass("baseline")" data-agent-nav="baseline" @onclick='() => SelectTab("baseline")'>Línea base</button>
            <button type="button" class="@NavClass("validation")" data-agent-nav="validation" @onclick='() => SelectTab("validation")'>Validación</button>
            <button type="button" class="@NavClass("settings")" data-agent-nav="settings" @onclick='() => SelectTab("settings")'>Configuración</button>
            <button type="button" class="@NavClass("export")" data-agent-nav="export" @onclick='() => SelectTab("export")'>Exportación</button>
        </nav>
        <div class="sidebar-footer">
            <span class="muted">Estado</span>
            <span class="status-pill @StatusClass(Vm.StatusText)">@Vm.StatusText</span>
        </div>
    </aside>

    <main class="content">
        <header class="topbar">
            <div>
                <h1>@PageTitle</h1>
                <p>@Vm.DetectionReadinessText</p>
            </div>
            <div class="actions">
                <button type="button" class="success-action" data-agent-action="start" @onclick="Vm.StartMonitoringAsync">Iniciar monitoreo</button>
                <button type="button" class="danger-action" data-agent-action="pause" @onclick="Vm.PauseMonitoringAsync">Pausar</button>
                <button type="button" class="secondary" data-agent-action="baseline" @onclick="Vm.BuildBaselineAsync">Construir línea base</button>
            </div>
        </header>

        <section class="notice">@Vm.ProgressMessage</section>

        @switch (Interaction.ActiveTab)
        {
            case "dashboard":
                @Dashboard()
                break;
            case "processes":
                @Processes()
                break;
            case "alerts":
                @Alerts()
                break;
            case "baseline":
                @Baseline()
                break;
            case "validation":
                @Validation()
                break;
            case "settings":
                @Settings()
                break;
            case "export":
                @Export()
                break;
        }
    </main>
</div>

@code {
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _timerCancellation;
    private bool _isSidebarCollapsed;
    private Alert? SelectedAlert => Interaction.SelectedAlertId is long id
        ? Vm.Alerts.FirstOrDefault(alert => alert.Id == id)
        : null;

    private string PageTitle => Interaction.ActiveTab switch
    {
        "processes" => "Procesos observados",
        "alerts" => "Alertas",
        "baseline" => "Línea base",
        "validation" => "Validación",
        "settings" => "Configuración",
        "export" => "Exportación",
        _ => "Panel"
    };

    protected override void OnInitialized()
    {
        Vm.PropertyChanged += OnViewModelChanged;
        Interaction.Changed += OnInteractionChanged;
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1.5));
        _timerCancellation = new CancellationTokenSource();
        _ = RefreshLoopAsync(_timerCancellation.Token);
    }

    private string NavClass(string tab) => tab == Interaction.ActiveTab ? "nav-link active" : "nav-link";

    private void ToggleSidebar()
    {
        _isSidebarCollapsed = !_isSidebarCollapsed;
    }

    private void SelectTab(string tab)
    {
        Interaction.SelectTab(tab);
        StateHasChanged();
    }

    private RenderFragment Dashboard() => @<div class="grid">
        <article class="card metric">
            <span>CPU total</span>
            <strong>@Vm.CpuTotalText</strong>
        </article>
        <article class="card metric">
            <span>Memoria</span>
            <strong>@Vm.MemoryText</strong>
        </article>
        <article class="card metric">
            <span>Procesos</span>
            <strong>@Vm.ProcessCount</strong>
        </article>
        <article class="card metric">
            <span>Alertas</span>
            <strong>@Vm.AlertCount</strong>
        </article>
        <article class="card wide">
            <h2>Resumen operativo</h2>
            @BaselineOverview(true)
            <dl>
                <dt>Última alerta</dt>
                <dd>@Vm.LastAlertText</dd>
                <dt>Escenario activo</dt>
                <dd>@Vm.ActiveScenarioText</dd>
                <dt>Desempeño agente</dt>
                <dd>@Vm.AgentPerformanceText</dd>
                <dt>Configuración</dt>
                <dd>@Vm.SettingsSummary</dd>
            </dl>
            <div class="button-row">
                <button type="button" data-agent-action="clear" @onclick="Vm.ClearExperimentDataAsync">Limpiar resultados</button>
                <button type="button" class="secondary" data-agent-action="export" @onclick="Vm.ExportAsync">Exportar CSV</button>
                <button type="button" class="secondary" data-agent-action="refresh" @onclick="Vm.RefreshFromDatabaseAsync">Actualizar</button>
            </div>
        </article>
    </div>;

    private RenderFragment SummaryChip(string label, string value, string? detail = null) => @<div class="summary-chip">
        <span>@label</span>
        <strong>@value</strong>
        @if (!string.IsNullOrWhiteSpace(detail))
        {
            <small>@detail</small>
        }
    </div>;

    private RenderFragment BaselineOverview(bool compact = false) => @<section class="summary-block">
        @if (Vm.ActiveBaseline is null)
        {
            <p class="muted summary-empty">Sin línea base activa. Construya una línea base para cargar procesos habituales.</p>
        }
        else
        {
            var baseline = Vm.ActiveBaseline;
            <div class="summary-grid @(compact ? "compact-summary" : string.Empty)">
                @SummaryChip("Procesos habituales", Vm.ProcessBaselines.Count.ToString(), "Aprendidos en la línea base")
                @SummaryChip("Creada", baseline.CreatedAt.ToString("g"))
                @SummaryChip("CPU media", $"{baseline.CpuAverage:N2}% +/- {baseline.CpuStdDev:N2}")
                @SummaryChip("RAM media", $"{baseline.MemoryAverage:N2}% +/- {baseline.MemoryStdDev:N2}")
                @if (!compact)
                {
                    @SummaryChip("CPU rango", $"{baseline.CpuMin:N2}% a {baseline.CpuMax:N2}%")
                    @SummaryChip("RAM rango", $"{baseline.MemoryMin:N2}% a {baseline.MemoryMax:N2}%")
                    @SummaryChip("TCP medio", baseline.NetworkConnectionAverage.ToString("N2"))
                    @SummaryChip("Cobertura de muestreo", BaselineCoverageText(baseline), BaselineSampleCountText(baseline))
                    @SummaryChip("Brecha máxima", BaselineGapText(baseline), "Continuidad de la construcción")
                }
            </div>
            <p class="baseline-note @(compact ? "compact-note" : string.Empty)">
                @Vm.BaselineProcessExplanation; se usa como referencia para comparar el monitoreo.
            </p>
        }
    </section>;

    private RenderFragment EvaluationOverview() => @<section class="summary-block">
        @if (Vm.EvaluationSummary is null)
        {
            <p class="muted summary-empty">@Vm.EvaluationSummaryText</p>
        }
        else
        {
            var summary = Vm.EvaluationSummary;
            <div class="summary-grid evaluation-summary">
                @SummaryChip("TP", summary.TruePositives.ToString(), "Sospechosos detectados")
                @SummaryChip("FP", summary.FalsePositives.ToString(), "Legítimos marcados como alerta")
                @SummaryChip("FN", summary.FalseNegatives.ToString(), "Sospechosos no detectados")
                @SummaryChip("TN", summary.TrueNegatives.ToString(), "Legítimos sin alerta")
                @SummaryChip("Precisión", $"{summary.Precision:P1}", "Alertas positivas correctas")
                @SummaryChip("Sensibilidad / Recall", $"{summary.Recall:P1}", "Sospechosos detectados")
                @SummaryChip("Tasa FP", $"{summary.FalsePositiveRate:P1}", "Falsas alertas sobre casos legítimos")
                @SummaryChip("Tiempo medio", $"{summary.AverageDetectionTimeSeconds:N1}s")
                @SummaryChip("Agente CPU", $"{summary.AgentAverageCpuPercent:N2}%")
                @SummaryChip("Agente RAM", $"{summary.AgentAverageMemoryMb:N1} MB")
                @SummaryChip("Agente RAM máxima", $"{summary.AgentMaximumMemoryMb:N1} MB")
                @SummaryChip("Cobertura línea base", $"{summary.BaselineCoverage:P1}")
                @SummaryChip("Claridad alertas", $"{summary.AlertClarityScore:P1}")
                @SummaryChip("Estadísticas", summary.StatisticalActivationCount.ToString(), "Comparaciones con línea base")
                @SummaryChip("Absolutas", summary.AbsoluteActivationCount.ToString(), "Umbrales fijos de laboratorio")
                @SummaryChip("Heurísticas", summary.HeuristicActivationCount.ToString(), "Reglas de comportamiento")
                @SummaryChip("Correlación", summary.CorrelationActivationCount.ToString(), "Coincidencia de varias señales")
            </div>
        }
    </section>;

    private RenderFragment Processes() => @<article class="card">
        <div class="section-head">
            <h2>Procesos activos</h2>
            <span class="muted">@FilteredProcesses.Count() visibles de @Vm.CurrentProcesses.Count</span>
        </div>
        <div class="table-tools">
            @FilterInput("process-search", "Buscar por PID, nombre o ruta")
            @SelectFilter("process-known", "Tipo", new[] { ("", "Todos"), ("known", "Habituales"), ("unknown", "No habituales") })
            <div class="column-tools">
                @ColumnToggle("process-pid", "PID")
                @ColumnToggle("process-name", "Nombre")
                @ColumnToggle("process-cpu", "CPU")
                @ColumnToggle("process-memory", "Memoria")
                @ColumnToggle("process-life", "Vida")
                @ColumnToggle("process-network", "TCP")
                @ColumnToggle("process-known", "Habitual")
                @ColumnToggle("process-time", "Observación")
                @ColumnToggle("process-path", "Ruta")
            </div>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        @if (Column("process-pid")) { @SortHeader("processes", "pid", "PID") }
                        @if (Column("process-name")) { @SortHeader("processes", "name", "Nombre") }
                        @if (Column("process-cpu")) { @SortHeader("processes", "cpu", "CPU") }
                        @if (Column("process-memory")) { @SortHeader("processes", "memory", "Memoria") }
                        @if (Column("process-life")) { @SortHeader("processes", "life", "Vida") }
                        @if (Column("process-network")) { @SortHeader("processes", "network", "TCP") }
                        @if (Column("process-known")) { @SortHeader("processes", "known", "Habitual") }
                        @if (Column("process-time")) { @SortHeader("processes", "time", "Última observación") }
                        @if (Column("process-path")) { @SortHeader("processes", "path", "Ruta") }
                    </tr>
                </thead>
                <tbody>
                @foreach (var process in FilteredProcesses.Take(250))
                {
                    <tr>
                        @if (Column("process-pid")) { <td>@process.ProcessId</td> }
                        @if (Column("process-name")) { <td>@process.ProcessName</td> }
                        @if (Column("process-cpu")) { <td>@FormatPercent(process.CpuPercent)</td> }
                        @if (Column("process-memory")) { <td>@FormatMb(process.MemoryMb)</td> }
                        @if (Column("process-life")) { <td>@FormatSeconds(process.LifetimeSeconds)</td> }
                        @if (Column("process-network")) { <td>@process.NetworkConnectionCount</td> }
                        @if (Column("process-known")) { <td><span class="badge @(process.IsKnownProcess ? "ok" : "danger")">@(process.IsKnownProcess ? "Habitual" : "No habitual")</span></td> }
                        @if (Column("process-time")) { <td>@process.Timestamp.ToString("g")</td> }
                        @if (Column("process-path")) { <td class="path">@process.ExecutablePath</td> }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </article>;

    private RenderFragment Alerts() => @<div class="split">
        <article class="card">
            <div class="section-head">
                <h2>Alertas generadas</h2>
                <span class="muted">@FilteredAlerts.Count() visibles de @Vm.AlertCount total</span>
            </div>
            <div class="table-tools">
                @FilterInput("alert-search", "Buscar por proceso, regla o descripción")
                @SelectFilter("alert-severity", "Severidad", new[] { ("", "Todas"), ("Alta", "Alta"), ("Media", "Media"), ("Baja", "Baja") })
                @SelectFilter("alert-status", "Estado", new[] { ("", "Todas"), ("pending", "Pendientes"), ("ack", "Revisadas") })
                <div class="column-tools">
                    @ColumnToggle("alert-select", "Selección")
                    @ColumnToggle("alert-date", "Fecha")
                    @ColumnToggle("alert-severity", "Severidad")
                    @ColumnToggle("alert-type", "Tipo")
                    @ColumnToggle("alert-rule", "Regla")
                    @ColumnToggle("alert-category", "Categoría")
                    @ColumnToggle("alert-process", "Proceso")
                    @ColumnToggle("alert-status", "Estado")
                </div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            @if (Column("alert-select")) { <th>Selección</th> }
                            @if (Column("alert-date")) { @SortHeader("alerts", "date", "Fecha") }
                            @if (Column("alert-severity")) { @SortHeader("alerts", "severity", "Severidad") }
                            @if (Column("alert-type")) { @SortHeader("alerts", "type", "Tipo") }
                            @if (Column("alert-rule")) { @SortHeader("alerts", "rule", "Regla") }
                            @if (Column("alert-category")) { @SortHeader("alerts", "category", "Categoría") }
                            @if (Column("alert-process")) { @SortHeader("alerts", "process", "Proceso") }
                            @if (Column("alert-status")) { @SortHeader("alerts", "status", "Estado") }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var alert in FilteredAlerts)
                    {
                        <tr class="@(Interaction.SelectedAlertId == alert.Id ? "selected-row" : "")">
                            @if (Column("alert-select")) { <td><button type="button" class="compact" data-agent-alert="@alert.Id" @onclick="() => Interaction.SelectAlert(alert.Id)">Ver detalle</button></td> }
                            @if (Column("alert-date")) { <td>@alert.Timestamp.ToString("g")</td> }
                            @if (Column("alert-severity")) { <td><span class="badge @SeverityClass(alert.Severity)">@alert.Severity</span></td> }
                            @if (Column("alert-type")) { <td>@alert.AlertType</td> }
                            @if (Column("alert-rule")) { <td>@alert.RuleName</td> }
                            @if (Column("alert-category")) { <td>@RuleCategoryLabel(alert.RuleCategory)</td> }
                            @if (Column("alert-process")) { <td>@alert.ProcessName</td> }
                            @if (Column("alert-status")) { <td>@(alert.WasAcknowledged ? "Revisada" : "Pendiente")</td> }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </article>

        <article class="card detail">
            @if (SelectedAlert is null)
            {
                <h2>Detalle de alerta</h2>
                <p class="muted">Use el botón <strong>Ver detalle</strong> en la primera columna de la tabla para seleccionar una alerta.</p>
            }
            else
            {
                var selectedAlert = SelectedAlert!;
                <h2>Alerta #@selectedAlert.Id</h2>
                <p><strong>@selectedAlert.AlertType</strong> - @selectedAlert.ProcessName</p>
                <p>@selectedAlert.Description</p>
                <p class="alert-explain">@AlertMethodologyExplanation(selectedAlert)</p>
                <dl>
                    <dt>Regla activada</dt><dd>@selectedAlert.RuleName</dd>
                    <dt>Categoría</dt><dd>@RuleCategoryLabel(selectedAlert.RuleCategory)</dd>
                    <dt>Métrica observada</dt><dd>@selectedAlert.MetricObserved</dd>
                    <dt>Referencia usada</dt><dd>@selectedAlert.BaselineReference</dd>
                    <dt>Valor observado</dt><dd>@AlertNumber(selectedAlert, selectedAlert.ObservedValue)</dd>
                    <dt>Promedio base</dt><dd>@AlertNumber(selectedAlert, selectedAlert.BaselineAverage)</dd>
                    <dt>Desviación estándar</dt><dd>@AlertNumber(selectedAlert, selectedAlert.BaselineStdDev)</dd>
                    <dt>Multiplicador</dt><dd>@AlertNumber(selectedAlert, selectedAlert.StdDevMultiplier)</dd>
                    <dt>Umbral calculado</dt><dd>@AlertNumber(selectedAlert, selectedAlert.CalculatedThreshold)</dd>
                    <dt>Umbral absoluto</dt><dd>@AlertNumber(selectedAlert, selectedAlert.AbsoluteThreshold)</dd>
                    <dt>Tipo de activación</dt><dd>@ThresholdTypeLabel(selectedAlert.ThresholdType)</dd>
                    <dt>Duración sostenida</dt><dd>@FormatSeconds(selectedAlert.SustainedDurationSeconds)</dd>
                    <dt>Evidencia técnica</dt><dd>@AlertEvidence(selectedAlert)</dd>
                    <dt>Recomendación</dt><dd>@selectedAlert.Recommendation</dd>
                </dl>
                <button type="button" data-agent-action="ack-alert" data-agent-alert-id="@selectedAlert.Id" @onclick="() => Vm.AcknowledgeAlertAsync(selectedAlert)">Marcar revisada</button>
            }
        </article>
    </div>;

    private RenderFragment Baseline() => @<article class="card">
        <div class="section-head">
            <div>
                <h2>Línea base activa</h2>
            </div>
            <button type="button" data-agent-action="baseline" @onclick="Vm.BuildBaselineAsync">Reconstruir línea base</button>
        </div>
        @BaselineOverview()
        <div class="table-tools">
            @FilterInput("baseline-search", "Buscar proceso base")
            <div class="column-tools">
                @ColumnToggle("baseline-process", "Proceso")
                @ColumnToggle("baseline-cpu-avg", "CPU media")
                @ColumnToggle("baseline-cpu-dev", "CPU desv.")
                @ColumnToggle("baseline-mem-avg", "Memoria media")
                @ColumnToggle("baseline-mem-dev", "Memoria desv.")
                @ColumnToggle("baseline-tcp-avg", "TCP media")
                @ColumnToggle("baseline-tcp-dev", "TCP desv.")
                @ColumnToggle("baseline-life", "Vida")
                @ColumnToggle("baseline-count", "Ocurrencias")
            </div>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        @if (Column("baseline-process")) { @SortHeader("baseline", "process", "Proceso") }
                        @if (Column("baseline-cpu-avg")) { @SortHeader("baseline", "cpuAvg", "CPU media") }
                        @if (Column("baseline-cpu-dev")) { @SortHeader("baseline", "cpuDev", "CPU desv.") }
                        @if (Column("baseline-mem-avg")) { @SortHeader("baseline", "memoryAvg", "Memoria media") }
                        @if (Column("baseline-mem-dev")) { @SortHeader("baseline", "memoryDev", "Memoria desv.") }
                        @if (Column("baseline-tcp-avg")) { @SortHeader("baseline", "tcpAvg", "TCP media") }
                        @if (Column("baseline-tcp-dev")) { @SortHeader("baseline", "tcpDev", "TCP desv.") }
                        @if (Column("baseline-life")) { @SortHeader("baseline", "life", "Vida típica") }
                        @if (Column("baseline-count")) { @SortHeader("baseline", "count", "Ocurrencias") }
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in FilteredBaselines)
                {
                    <tr>
                        @if (Column("baseline-process")) { <td>@item.ProcessName</td> }
                        @if (Column("baseline-cpu-avg")) { <td>@FormatPercent(item.AverageCpu)</td> }
                        @if (Column("baseline-cpu-dev")) { <td>@FormatPercent(item.StdDevCpu)</td> }
                        @if (Column("baseline-mem-avg")) { <td>@FormatMb(item.AverageMemory)</td> }
                        @if (Column("baseline-mem-dev")) { <td>@FormatMb(item.StdDevMemory)</td> }
                        @if (Column("baseline-tcp-avg")) { <td>@FormatNullable(item.AverageNetworkConnections)</td> }
                        @if (Column("baseline-tcp-dev")) { <td>@FormatNullable(item.StdDevNetworkConnections)</td> }
                        @if (Column("baseline-life")) { <td>@FormatSeconds(item.TypicalLifetimeSeconds)</td> }
                        @if (Column("baseline-count")) { <td>@item.OccurrenceCount</td> }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </article>;

    private RenderFragment Validation() => @<div class="grid validation-grid">
        <article class="card wide">
            <h2>Simulaciones seguras</h2>
            <p class="muted">Solo reproducen comportamientos observables. No hay malware, minería real ni infraestructura externa.</p>
            <div class="button-row">
                <button type="button" data-agent-scenario="UsoNormal" @onclick='() => Vm.RunScenarioAsync("UsoNormal")'>Uso normal</button>
                <button type="button" data-agent-scenario="CargaLegitimaTemporal" @onclick='() => Vm.RunScenarioAsync("CargaLegitimaTemporal")'>Carga legítima temporal</button>
                <button type="button" data-agent-scenario="CriptomineriaSimulada" @onclick='() => Vm.RunScenarioAsync("CriptomineriaSimulada")'>Criptominería simulada</button>
                <button type="button" data-agent-scenario="BotnetSimulada" @onclick='() => Vm.RunScenarioAsync("BotnetSimulada")'>Botnet simulada</button>
                <button type="button" data-agent-scenario="ProcesoPersistenteSimulado" @onclick='() => Vm.RunScenarioAsync("ProcesoPersistenteSimulado")'>Proceso persistente</button>
                <button type="button" data-agent-scenario="RutaSospechosaSimulada" @onclick='() => Vm.RunScenarioAsync("RutaSospechosaSimulada")'>Nombre o ruta sospechosa</button>
                <button type="button" data-agent-scenario="Combinado" @onclick='() => Vm.RunScenarioAsync("Combinado")'>Escenario combinado</button>
                <button type="button" class="danger-action" data-agent-action="stop-simulation" @onclick="Vm.StopSimulationAsync">Detener simulación</button>
            </div>
            <strong>@Vm.ActiveScenarioText</strong>
        </article>
        <article class="card wide">
            <h2>Métricas de evaluación</h2>
            @EvaluationOverview()
        </article>
        <article class="card wide">
            <div class="section-head">
                <h2>Escenarios registrados</h2>
                <span class="muted">@FilteredScenarios.Count() visibles de @Vm.ValidationScenarios.Count</span>
            </div>
            <div class="table-tools">
                @FilterInput("scenario-search", "Buscar escenario, resultado o notas")
                <div class="column-tools">
                    @ColumnToggle("scenario-start", "Inicio")
                    @ColumnToggle("scenario-end", "Fin")
                    @ColumnToggle("scenario-name", "Escenario")
                    @ColumnToggle("scenario-category", "Tipo")
                    @ColumnToggle("scenario-description", "Descripción")
                    @ColumnToggle("scenario-process", "Proceso")
                    @ColumnToggle("scenario-duration", "Duración")
                    @ColumnToggle("scenario-expected", "Esperado")
                    @ColumnToggle("scenario-result", "Obtenido")
                    @ColumnToggle("scenario-classification", "Clasificación")
                    @ColumnToggle("scenario-confusion", "Resultado")
                    @ColumnToggle("scenario-alert", "Alerta")
                    @ColumnToggle("scenario-time", "Tiempo")
                    @ColumnToggle("scenario-notes", "Observaciones")
                </div>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            @if (Column("scenario-start")) { @SortHeader("scenarios", "start", "Inicio") }
                            @if (Column("scenario-end")) { @SortHeader("scenarios", "end", "Fin") }
                            @if (Column("scenario-name")) { @SortHeader("scenarios", "name", "Escenario") }
                            @if (Column("scenario-category")) { @SortHeader("scenarios", "category", "Tipo") }
                            @if (Column("scenario-description")) { @SortHeader("scenarios", "description", "Descripción") }
                            @if (Column("scenario-process")) { @SortHeader("scenarios", "process", "Proceso") }
                            @if (Column("scenario-duration")) { @SortHeader("scenarios", "duration", "Duración") }
                            @if (Column("scenario-expected")) { @SortHeader("scenarios", "expected", "Esperado") }
                            @if (Column("scenario-result")) { @SortHeader("scenarios", "actual", "Obtenido") }
                            @if (Column("scenario-classification")) { @SortHeader("scenarios", "classification", "Clasificación") }
                            @if (Column("scenario-confusion")) { @SortHeader("scenarios", "confusion", "Resultado") }
                            @if (Column("scenario-alert")) { @SortHeader("scenarios", "alert", "Alerta") }
                            @if (Column("scenario-time")) { @SortHeader("scenarios", "time", "Tiempo") }
                            @if (Column("scenario-notes")) { @SortHeader("scenarios", "notes", "Observaciones") }
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var scenario in FilteredScenarios)
                    {
                        <tr>
                            @if (Column("scenario-start")) { <td>@scenario.StartedAt.ToString("g")</td> }
                            @if (Column("scenario-end")) { <td>@(scenario.FinishedAt?.ToString("g") ?? "En ejecución")</td> }
                            @if (Column("scenario-name")) { <td>@scenario.Name</td> }
                            @if (Column("scenario-category")) { <td>@scenario.ScenarioCategory</td> }
                            @if (Column("scenario-description")) { <td>@scenario.Description</td> }
                            @if (Column("scenario-process"))
                            {
                                <td>
                                    <div>@scenario.ProcessName</div>
                                    @if (scenario.ProcessId is not null) { <small class="muted">PID @scenario.ProcessId</small> }
                                </td>
                            }
                            @if (Column("scenario-duration")) { <td>@FormatSeconds(scenario.DurationSeconds)</td> }
                            @if (Column("scenario-expected")) { <td>@scenario.ExpectedResult</td> }
                            @if (Column("scenario-result")) { <td>@scenario.ActualResult</td> }
                            @if (Column("scenario-classification")) { <td>@scenario.ActualClassification</td> }
                            @if (Column("scenario-confusion")) { <td>@scenario.ConfusionResult</td> }
                            @if (Column("scenario-alert")) { <td>@(scenario.AlertGenerated ? "Sí" : "No")</td> }
                            @if (Column("scenario-time")) { <td>@FormatSeconds(scenario.DetectionTimeSeconds)</td> }
                            @if (Column("scenario-notes"))
                            {
                                <td>
                                    <div>@scenario.Notes</div>
                                    @if (scenario.TelemetrySampleCount > 0) { <small class="muted">@ScenarioTelemetrySummary(scenario)</small> }
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </article>
    </div>;

    private RenderFragment Settings() => @<article class="card settings-card">
        <div class="section-head">
            <div>
                <h2>Configuración efectiva</h2>
                <p>Esta sección es de solo lectura. Los criterios estadísticos se derivan de la línea base activa y cambian cuando la reconstruyes.</p>
            </div>
            <span class="badge @(Vm.ActiveBaseline is null ? "danger" : "ok")">@(Vm.ActiveBaseline is null ? "Sin línea base" : "Derivada de línea base")</span>
        </div>

        @if (Vm.ActiveBaseline is null)
        {
            <section class="notice">Construye una línea base para ver los umbrales efectivos del equipo.</section>
        }
        else
        {
            var baseline = Vm.ActiveBaseline;
            <h2 class="subhead">Criterios derivados de línea base</h2>
            <div class="settings-grid">
                @ReadOnlyMetric("Creada", baseline.CreatedAt.ToString("g"))
                @ReadOnlyMetric("Duración aprendizaje", $"{baseline.LearningDurationMinutes} min")
                @ReadOnlyMetric("Cobertura de muestreo", $"{BaselineCoverageText(baseline)} ({BaselineSampleCountText(baseline)})")
                @ReadOnlyMetric("Brecha máxima de muestras", BaselineGapText(baseline))
                @ReadOnlyMetric("CPU media sistema", FormatPercent(baseline.CpuAverage))
                @ReadOnlyMetric("CPU desviación", FormatPercent(baseline.CpuStdDev))
                @ReadOnlyMetric("CPU rango típico", $"{FormatPercent(baseline.CpuMin)} a {FormatPercent(baseline.CpuMax)}")
                @ReadOnlyMetric("Umbral CPU global", FormatPercent(GlobalCpuThreshold))
                @ReadOnlyMetric("Memoria media sistema", FormatPercent(baseline.MemoryAverage))
                @ReadOnlyMetric("Memoria desviación", FormatPercent(baseline.MemoryStdDev))
                @ReadOnlyMetric("Memoria rango típico", $"{FormatPercent(baseline.MemoryMin)} a {FormatPercent(baseline.MemoryMax)}")
                @ReadOnlyMetric("Umbral memoria global", FormatPercent(GlobalMemoryThreshold))
                @ReadOnlyMetric("TCP medio sistema", FormatNullable(baseline.NetworkConnectionAverage))
                @ReadOnlyMetric("Procesos habituales", Vm.ProcessBaselines.Count.ToString())
                @ReadOnlyMetric("Umbral CPU por proceso", "Media proceso + N desviaciones")
                @ReadOnlyMetric("Umbral memoria por proceso", "Media proceso + N desviaciones")
                @ReadOnlyMetric("Umbral TCP por proceso", "Media proceso + N desviaciones")
            </div>
        }

        <h2 class="subhead">Constantes metodológicas del experimento</h2>
        <p class="muted">Estos valores no salen de la línea base: son criterios fijos definidos para la prueba. La línea base aporta medias y desviaciones; estas constantes indican cómo compararlas y durante cuánto tiempo sostener la condición.</p>
        <div class="settings-grid">
            @ReadOnlyMetric("Intervalo monitoreo", $"{Vm.Settings.MonitoringIntervalSeconds}s")
            @ReadOnlyMetric("Aprendizaje configurado", $"{Vm.Settings.BaselineLearningMinutes} min")
            @ReadOnlyMetric("Cobertura mínima de aprendizaje", $"{Vm.Settings.BaselineMinimumSampleCoveragePercent:N0}%")
            @ReadOnlyMetric("Multiplicador estadístico", $"{Vm.Settings.StandardDeviationMultiplier:N2} desviaciones")
            @ReadOnlyMetric("Mínimo CPU defensivo", FormatPercent(Vm.Settings.MinCpuThreshold))
            @ReadOnlyMetric("CPU sostenida", $"{Vm.Settings.SustainedCpuSeconds}s")
            @ReadOnlyMetric("Memoria sostenida", $"{Vm.Settings.SustainedMemorySeconds}s")
            @ReadOnlyMetric("CPU absoluta laboratorio", FormatPercent(Vm.Settings.CpuAbsoluteThresholdPercent))
            @ReadOnlyMetric("Memoria absoluta laboratorio", FormatMb(Vm.Settings.MemoryAbsoluteThresholdMb))
        </div>

        <h2 class="subhead">Reglas activas</h2>
        <div class="toggle-grid readonly-rules">
            @RuleBadge("CPU por proceso", Vm.Settings.EnableCpuRule)
            @RuleBadge("Memoria por proceso", Vm.Settings.EnableMemoryRule)
            @RuleBadge("Proceso nuevo", Vm.Settings.EnableNewProcessRule)
            @RuleBadge("Ruta sospechosa", Vm.Settings.EnableSuspiciousPathRule)
            @RuleBadge("Actividad periódica", Vm.Settings.EnablePeriodicActivityRule)
            @RuleBadge("Correlación", Vm.Settings.EnableCorrelationRule)
            @RuleBadge("CPU global", Vm.Settings.EnableGlobalCpuRule)
